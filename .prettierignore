# Prettier's globs in package.json (`**/*.{ts,tsx,js,jsx,json,md}`) reach build output and vendored
# trees, so `format:check` was reporting on files nobody edits by hand. node_modules is ignored by
# default; everything below is not.

# Build output / caches
dist/
**/dist/
coverage/
**/coverage/
.next/
**/.next/
.turbo/
**/.turbo/
target/
**/target/

# Generated, and not ours to format
pnpm-lock.yaml
**/*.tsbuildinfo

# Harness + gallery artifacts (gitignored, regenerated by pnpm test:layout / gen-gallery)
packages/pcb-core/.gallery/
packages/pcb-core/.layout-check/
packages/pcb-core/.drc-diag/
packages/pcb-core/.placement-ab/
packages/pcb-core/.route-parallel-ab/
packages/pcb-core/.route-profile/
packages/pcb-core/.rust-layout-e2e/
packages/pcb-core/.mt-test/

# An unpacked copy of the published npm tarball, kept for diffing releases — not source.
eda-check/
