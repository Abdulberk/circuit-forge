{
    "name": "@circuit-forge/pcb-preflight",
    "version": "0.1.0",
    "description": "Can this circuit become a board, and what would each part become? Pure classification — no evaluator, no exporters, no I/O.",
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    },
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc",
        "prepublishOnly": "npm run build",
        "dev": "tsc --watch",
        "lint": "eslint src --ext .ts",
        "lint:fix": "eslint src --ext .ts --fix",
        "test": "jest",
        "clean": "rm -rf dist coverage",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@circuit-forge/eda-core": "workspace:*"
    },
    "peerDependencies": {
        "@tscircuit/footprinter": "*"
    },
    "peerDependenciesMeta": {
        "@tscircuit/footprinter": {
            "optional": true
        }
    },
    "devDependencies": {
        "@types/jest": "^29.5.12",
        "@types/node": "^22.7.5",
        "jest": "^29.7.0",
        "ts-jest": "^29.2.5",
        "typescript": "^5.9.3"
    }
}
