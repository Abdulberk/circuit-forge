{
    "name": "@circuit-forge/eda-core",
    "version": "1.5.0",
    "description": "Circuit manipulation, netlist generation, and SPICE parsing library",
    "license": "MIT",
    "author": "Abdulberk",
    "homepage": "https://github.com/Abdulberk/circuit-forge/tree/main/packages/eda-core#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Abdulberk/circuit-forge.git",
        "directory": "packages/eda-core"
    },
    "bugs": {
        "url": "https://github.com/Abdulberk/circuit-forge/issues"
    },
    "keywords": [
        "spice",
        "ngspice",
        "netlist",
