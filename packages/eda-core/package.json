        "test:cov": "jest --coverage",
        "clean": "rm -rf dist coverage",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "zod": "^3.22.4"
    },
    "devDependencies": {
        "@types/jest": "^29.5.11",
        "@types/node": "^20.11.0",
        "jest": "^29.7.0",
        "ts-jest": "^29.1.1",
        "typescript": "^5.3.3"
    },
    "peerDependencies": {
        "typescript": "^5.0.0"
