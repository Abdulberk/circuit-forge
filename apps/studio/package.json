{
    "name": "@circuit-forge/studio",
    "version": "0.1.0",
    "private": true,
    "description": "The design studio: the editor kernel driven by the real API. A harness that is also the product.",
    "scripts": {
        "dev": "next dev -p 3200",
        "build": "next build",
        "start": "next start -p 3200",
        "lint": "eslint app lib components --ext .ts,.tsx",
        "lint:fix": "eslint app lib components --ext .ts,.tsx --fix",
        "test": "jest --passWithNoTests",
        "typecheck": "tsc --noEmit",
        "clean": "rm -rf .next coverage",
        "test:e2e": "jest --testMatch \"**/*.e2e.spec.ts\" --testPathIgnorePatterns \"/node_modules/\" --runInBand"
    },
    "dependencies": {
        "@circuit-forge/eda-core": "workspace:*",
        "@circuit-forge/editor-core": "workspace:*",
        "@circuit-forge/pcb-contract": "workspace:*",
        "next": "15.5.4",
        "react": "19.2.7",
        "react-dom": "19.2.7"
    },
    "devDependencies": {
        "@testing-library/dom": "^10",
        "@testing-library/react": "^16",
        "@types/jest": "^29.5.12",
        "@types/node": "^22.7.5",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^29",
        "ts-jest": "^29.2.5",
        "typescript": "^5.9.3"
    }
}
