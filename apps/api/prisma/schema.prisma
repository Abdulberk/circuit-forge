// Prisma schema for Circuit Forge
// Multi-tenant architecture with organizations, projects, and simulations

generator client {
  provider = "prisma-client-js"
  // NOTE: Prisma query tracing ("tracing" previewFeature + @prisma/instrumentation) is intentionally
  // OFF — @prisma/instrumentation@5.22 is incompatible with this repo's @opentelemetry/sdk-trace-base
  // (crashes via the removed getActiveSpanProcessor). Re-enable once the versions are compatible.
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// User & Authentication
// ============================================================================

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Brute-force lockout: failed-login counter resets on success; lockedUntil gates login while set.
  failedLoginCount  Int       @default(0)
  lastFailedLoginAt DateTime?
  lockedUntil       DateTime?

  // Account lifecycle. Tokens are stored as sha256 hashes (never plaintext) with an expiry; the raw
  // token travels only in the emailed link. emailVerified gates verified-only features (opt-in).
  emailVerified              Boolean   @default(false)
  emailVerificationTokenHash String?
  emailVerificationExpiresAt DateTime?
  passwordResetTokenHash     String?
  passwordResetExpiresAt     DateTime?

  // Platform-admin identity — ORTHOGONAL to the tenant OrgRole (that is per-org; this is per-user,
  // platform-wide). NONE = ordinary user. Graduated least-privilege: SUPPORT reads, OPERATOR mutates,
  // ADMIN does destructive/config + role management. Read LIVE from the DB by PlatformAdminGuard on
  // every /admin/* request, so a demotion takes effect on the very next request (no stale JWT claim).
  platformRole PlatformRole @default(NONE)

  // Relations
  memberships         OrgMembership[]
  invitationsSent     OrgInvitation[]      @relation("InvitationsSent")
  invitationsAccepted OrgInvitation[]      @relation("InvitationsAccepted")
  projectVersions     ProjectVersion[]
  workingCopyEdits    ProjectWorkingCopy[]
  auditLogs           AuditLog[]           @relation("AuditSubject")
  adminAuditLogs      AuditLog[]           @relation("AdminActor")
  refreshTokens       RefreshToken[]

  @@map("users")
}

enum PlatformRole {
  NONE
  SUPPORT
  OPERATOR
  ADMIN
}

// Server-side refresh-token state: every issued refresh JWT has a row here (keyed by its jti).
// Rotation marks the old row used and issues a successor in the same FAMILY (one family per login/
// device). Reuse of an already-used token is theft evidence -> the whole family is revoked. Logout
// revokes the presented token's family (or all of the user's). Raw tokens are never stored — jti
// lookup + sha256 hash check.
model RefreshToken {
  id        String    @id @default(uuid())
  jti       String    @unique
  userId    String
  familyId  String
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime? // set when rotated (successor issued)
  revokedAt DateTime? // set by logout / reuse detection
  ip        String? // session metadata (device management later)
  userAgent String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// ============================================================================
// Organization & Membership
// ============================================================================

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Platform-admin suspension. When set, the SHARED write path (UsageService) rejects every
  // enqueue/upload for this org with 403 ORG_SUSPENDED; READS stay allowed so members can still see
  // their data and the reason. Reinstating clears both fields.
  suspendedAt   DateTime?
  suspendReason String?

  // Relations
  memberships    OrgMembership[]
  invitations    OrgInvitation[]
  projects       Project[]
  templates      Template[]
  assets         Asset[]
  simulationJobs SimulationJob[]
  designJobs     DesignJob[]
  layoutJobs     LayoutJob[]
  auditLogs      AuditLog[]
  quotaOverride  OrgQuotaOverride?

  @@map("organizations")
}

// Per-org quota overrides. The env QUOTA_* values are the GLOBAL default; a row here overrides them
// for a single org (UsageService.limit reads this first, falls back to env). A NULL column = inherit
// the env default for that metric. One row per org (orgId is the PK).
model OrgQuotaOverride {
  orgId                String   @id
  simConcurrent        Int?
  simJobsPerMonth      Int?
  simRuntimeMsPerMonth Int?
  designConcurrent     Int?
  designJobsPerMonth   Int?
  storageBytes         BigInt? // bytes can exceed Int32 (a 5GB cap > 2.1e9), so BigInt
  partsCallsPerMonth   Int?
  updatedByAdminId     String?
  updatedAt            DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("org_quota_overrides")
}

model OrgMembership {
  id        String   @id @default(uuid())
  orgId     String
  userId    String
  role      OrgRole  @default(MEMBER)
  createdAt DateTime @default(now())

  // Relations
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@map("org_memberships")
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

// A pending invitation for someone to join an org (self-serve team growth). The raw token travels only in
// the emailed link; we store its sha256 hash and match by hashing the presented token (same recipe as the
// email-verify / password-reset tokens). One live invite per (org, email) — a re-invite refreshes the row.
model OrgInvitation {
  id               String              @id @default(uuid())
  orgId            String
  email            String // normalized (trim + lowercase) — the address the invite was sent to
  role             OrgRole             @default(MEMBER)
  tokenHash        String // sha256 of the emailed token; the raw token is never stored
  status           OrgInvitationStatus @default(PENDING)
  invitedByUserId  String
  expiresAt        DateTime
  acceptedAt       DateTime?
  acceptedByUserId String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invitedBy  User         @relation("InvitationsSent", fields: [invitedByUserId], references: [id])
  acceptedBy User?        @relation("InvitationsAccepted", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@unique([orgId, email]) // one invite per email per org; re-inviting UPSERTS (fresh token + expiry)
  @@index([tokenHash])
  @@map("org_invitations")
}

enum OrgInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

// ============================================================================
// Projects & Versions
// ============================================================================

model Project {
  id          String   @id @default(uuid())
  orgId       String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  org         Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  versions    ProjectVersion[]
  pcbLayouts  LayoutJob[]
  workingCopy ProjectWorkingCopy?

  @@unique([orgId, name])
  @@map("projects")
}

model ProjectVersion {
  id              String   @id @default(uuid())
  projectId       String
  versionNumber   Int
  createdByUserId String
  circuitJson     Json     // Canonical circuit representation
  uiJson          Json     // Layout/UI state
  createdAt       DateTime @default(now())

  // Relations
  project           Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy         User                 @relation(fields: [createdByUserId], references: [id])
  simulationJobs    SimulationJob[]
  pcbLayouts        LayoutJob[]
  workingCopiesBase ProjectWorkingCopy[] // drafts that descend from this version (baseVersionId)

  @@unique([projectId, versionNumber])
  @@map("project_versions")
}

// One MUTABLE draft per project — the live "working copy" the editor autosaves to (debounced, single-
// writer, last-writer-wins across a user's tabs/devices). Kept in its OWN table, NOT on Project, so the
// hot + large circuit/UI blobs never widen the Project metadata row that list/read endpoints scan. This is
// the standard "continuous autosave" split: this row is the whiteboard (overwritten in place), while
// ProjectVersion is the immutable photo archive that "Save version" snapshots into. v1 is deliberately
// single-writer — no CRDT/OT co-editing; if that lands later, its state slots in here.
model ProjectWorkingCopy {
  projectId       String   @id // 1:1 — the PK IS the project id, so a project has at most one draft
  circuitJson     Json
  uiJson          Json
  // Provenance: which saved version this draft descends from (for "N unsaved changes since v3" UX). Null
  // for a project with no versions yet. SetNull so deleting that version doesn't drop the in-progress draft.
  baseVersionId   String?
  updatedByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  baseVersion ProjectVersion? @relation(fields: [baseVersionId], references: [id], onDelete: SetNull)
  updatedBy   User            @relation(fields: [updatedByUserId], references: [id])

  @@index([baseVersionId])
  @@map("project_working_copies")
}

// ============================================================================
// Templates
// ============================================================================

model Template {
  id          String   @id @default(uuid())
  orgId       String?  // null = public template
  name        String
  description String?
  tags        String[]
  circuitJson Json
  // Optional recommended simulation setup: { analysis: AnalysisConfig, probes?: string[] }. Lets a template
  // carry the analysis it was validated with — including tran initialConditions (e.g. an oscillator's
  // startup seed), which CircuitJson itself cannot express. Frontend "Run" uses this when present.
  analysisConfig Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  org Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("templates")
}

// ============================================================================
// Assets (SPICE models, symbol packs, etc.)
// ============================================================================

model Asset {
  id          String    @id @default(uuid())
  orgId       String
  type        AssetType
  name        String
  description String?
  contentType String
  sizeBytes   Int
  s3Key       String
  sha256      String
  createdAt   DateTime  @default(now())

  // Relations
  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // The storage quota aggregates SUM(sizeBytes) per org on every upload presign.
  @@index([orgId])
  @@map("assets")
}

enum AssetType {
  SPICE_MODEL
  SYMBOL_PACK
  OTHER
}

// ============================================================================
// Simulation Jobs
// ============================================================================

model SimulationJob {
  id               String       @id @default(uuid())
  orgId            String
  projectVersionId String?
  status           SimJobStatus @default(QUEUED)
  engine           SimEngine    @default(NGSPICE)
  analysisConfig   Json
  netlist          String       @db.Text
  stdout           String?      @db.Text
  stderr           String?      @db.Text
  resultJson       Json?
  resultS3Key      String?
  metrics          Json?        // { runtimeMs, peakMemBytes, pointsCount }
  errorMessage     String?
  createdAt        DateTime     @default(now())
  startedAt        DateTime?
  finishedAt       DateTime?

  // Relations
  org            Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  projectVersion ProjectVersion? @relation(fields: [projectVersionId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
  @@index([status])
  @@map("simulation_jobs")
}

enum SimJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELED
  TIMED_OUT
}

enum SimEngine {
  NGSPICE
}

// ============================================================================
// AI Design Jobs (async closed-loop design)
// ============================================================================

// One persisted record per /design-jobs request — the long-running-operation (LRO) handle the client
// polls. The agentic loop (generate → simulate → fix, up to maxRounds) can take minutes, so the request
// returns 202 + this row's id immediately and the loop runs detached, writing its outcome here. `result`
// holds the full design() payload (circuit/analysis/explanation/history/verdict/criteria/assertions/
// caveats). `abortRequested` is the cooperative-cancel flag the loop checks (honored mid-loop once the
// loop core is relocated; today it stops a not-yet-started job). Mirrors SimulationJob's shape/indexing.
model DesignJob {
  id             String          @id @default(uuid())
  orgId          String
  userId         String
  status         DesignJobStatus @default(QUEUED)
  // Input (the DesignCircuitDto)
  prompt         String          @db.Text
  constraints    String?         @db.Text
  maxRounds      Int             @default(2)
  // Output — the full design() result object; null until the loop finishes.
  result         Json?
  errorMessage   String?
  // Cooperative-cancel flag the detached/worker loop checks (between rounds / before start).
  abortRequested Boolean         @default(false)
  createdAt      DateTime        @default(now())
  startedAt      DateTime?
  finishedAt     DateTime?

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
  @@index([status])
  @@map("design_jobs")
}

enum DesignJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELED
}

// Async PCB layout job (the LRO behind /layouts). The pcb-worker runs pcb-core's quality pipeline
// (freerouting + kicad-cli) and writes the outcome here; the client polls the row. Mirrors DesignJob's
// shape/indexing. Heavy blobs (GLB, Gerbers/BOM/PnP) go to S3 — glbKey/gerbersKey hold their object keys;
// `result` keeps only the bounded metadata (shaped geometry + DRC checks + airwires + stats + the keys).
model LayoutJob {
  id             String          @id @default(uuid())
  orgId          String
  userId         String
  // Optional linkage to the saved circuit this layout was generated from. Lets the client re-find a
  // layout after a page reload (GET /layouts?versionId=) and list every layout for a project/version,
  // instead of holding the job id only in browser memory. Nullable + SetNull: an ad-hoc layout of an
  // unsaved circuit has neither, and deleting a project/version never loses the org's layout history.
  projectId      String?
  versionId      String?
  status         LayoutJobStatus @default(QUEUED)
  // Input: OUR CircuitJson (topology) + optional layout options (placer/fabProfile/netCurrentsA).
  circuit        Json
  options        Json?
  // Output — bounded metadata (LayoutGeometry + checks + airwires + stats); null until finished.
  result         Json?
  // S3 object keys for the heavy artifacts (the API presigns these for the client).
  glbKey         String?
  gerbersKey     String?
  errorMessage   String?
  // Cooperative-cancel flag (parity with DesignJob; the worker checks it before/where applicable).
  abortRequested Boolean         @default(false)
  createdAt      DateTime        @default(now())
  startedAt      DateTime?
  finishedAt     DateTime?

  org     Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  version ProjectVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
  @@index([status])
  @@index([versionId])
  @@index([projectId])
  @@map("layout_jobs")
}

enum LayoutJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELED
}

// ============================================================================
// Audit Logs
// ============================================================================

model AuditLog {
  id           String   @id @default(uuid())
  orgId        String? // null = user-scoped event (auth.* — login, reset, …) with no org context
  // Subject of the event. Nullable + onDelete:SetNull so the audit trail OUTLIVES account deletion
  // (enterprise access-transparency / SOC 2): erasing a user anonymizes the actor (userId → null) but
  // KEEPS the row and its security-evidence (refresh_reuse_detected, account_locked). A GDPR erase
  // scrubs PII out of meta separately. (Was: required + cascade — GDPR-aligned but lost the trail.)
  userId       String?
  // The platform admin who INITIATED this event (null = the subject's own, non-admin action). Nullable
  // + SetNull for the same reason: an admin's own account deletion must not erase the trail they wrote.
  adminActorId String?
  action       String // e.g., "project.create", "simulation.start", "admin.org.suspend"
  entityType   String // e.g., "Project", "SimulationJob", "User", "Organization"
  entityId     String
  meta         Json? // { requestId, before, after, adminActorEmail, reason, ... }
  createdAt    DateTime @default(now())

  // onDelete: SetNull (NOT Cascade) — the audit trail OUTLIVES its subject org, same as userId/adminActor
  // above. Deleting an org (a future org-erase / GDPR path) must ANONYMIZE the org reference (orgId → null),
  // never DELETE the security-evidence rows written under it (suspend, quota_override, member changes).
  org        Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)
  user       User?         @relation("AuditSubject", fields: [userId], references: [id], onDelete: SetNull)
  adminActor User?         @relation("AdminActor", fields: [adminActorId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
  @@index([userId, createdAt])
  @@index([entityType, entityId])
  // Admin console filters by action ('admin.*') and by the acting admin — index both so the
  // platform-wide audit read (Phase 1) doesn't table-scan.
  @@index([action, createdAt])
  @@index([adminActorId, createdAt])
  @@map("audit_logs")
}
// ============================================================================
// Usage metering (quota counters that have no natural source table — e.g. parts catalog calls).
// Sim runtime/jobs and storage are aggregated ON-DEMAND from SimulationJob / Asset (drift-free),
// so they intentionally have NO counter rows here.
// ============================================================================

model UsageRecord {
  id        String   @id @default(uuid())
  scope     String // 'org' | 'user'
  scopeId   String
  metric    String // e.g. 'parts_calls'
  period    String // UTC month, 'YYYY-MM'
  amount    Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([scope, scopeId, metric, period])
  @@map("usage_records")
}
