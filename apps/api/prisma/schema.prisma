// Prisma schema for Circuit Forge
// Multi-tenant architecture with organizations, projects, and simulations

generator client {
  provider = "prisma-client-js"
  // NOTE: Prisma query tracing ("tracing" previewFeature + @prisma/instrumentation) is intentionally
  // OFF — @prisma/instrumentation@5.22 is incompatible with this repo's @opentelemetry/sdk-trace-base
  // (crashes via the removed getActiveSpanProcessor). Re-enable once the versions are compatible.
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// User & Authentication
// ============================================================================

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Brute-force lockout: failed-login counter resets on success; lockedUntil gates login while set.
  failedLoginCount  Int       @default(0)
  lastFailedLoginAt DateTime?
  lockedUntil       DateTime?

  // Account lifecycle. Tokens are stored as sha256 hashes (never plaintext) with an expiry; the raw
  // token travels only in the emailed link. emailVerified gates verified-only features (opt-in).
  emailVerified              Boolean   @default(false)
  emailVerificationTokenHash String?
  emailVerificationExpiresAt DateTime?
  passwordResetTokenHash     String?
  passwordResetExpiresAt     DateTime?

  // Relations
  memberships     OrgMembership[]
  projectVersions ProjectVersion[]
  auditLogs       AuditLog[]
  refreshTokens   RefreshToken[]

  @@map("users")
}

// Server-side refresh-token state: every issued refresh JWT has a row here (keyed by its jti).
// Rotation marks the old row used and issues a successor in the same FAMILY (one family per login/
// device). Reuse of an already-used token is theft evidence -> the whole family is revoked. Logout
// revokes the presented token's family (or all of the user's). Raw tokens are never stored — jti
// lookup + sha256 hash check.
model RefreshToken {
  id        String    @id @default(uuid())
  jti       String    @unique
  userId    String
  familyId  String
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime? // set when rotated (successor issued)
  revokedAt DateTime? // set by logout / reuse detection
  ip        String? // session metadata (device management later)
  userAgent String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// ============================================================================
// Organization & Membership
// ============================================================================

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  memberships    OrgMembership[]
  projects       Project[]
  templates      Template[]
  assets         Asset[]
  simulationJobs SimulationJob[]
  auditLogs      AuditLog[]

  @@map("organizations")
}

model OrgMembership {
  id        String   @id @default(uuid())
  orgId     String
  userId    String
  role      OrgRole  @default(MEMBER)
  createdAt DateTime @default(now())

  // Relations
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@map("org_memberships")
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

// ============================================================================
// Projects & Versions
// ============================================================================

model Project {
  id          String   @id @default(uuid())
  orgId       String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  org      Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  versions ProjectVersion[]

  @@unique([orgId, name])
  @@map("projects")
}

model ProjectVersion {
  id              String   @id @default(uuid())
  projectId       String
  versionNumber   Int
  createdByUserId String
  circuitJson     Json     // Canonical circuit representation
  uiJson          Json     // Layout/UI state
  createdAt       DateTime @default(now())

  // Relations
  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy      User            @relation(fields: [createdByUserId], references: [id])
  simulationJobs SimulationJob[]

  @@unique([projectId, versionNumber])
  @@map("project_versions")
}

// ============================================================================
// Templates
// ============================================================================

model Template {
  id          String   @id @default(uuid())
  orgId       String?  // null = public template
  name        String
  description String?
  tags        String[]
  circuitJson Json
  // Optional recommended simulation setup: { analysis: AnalysisConfig, probes?: string[] }. Lets a template
  // carry the analysis it was validated with — including tran initialConditions (e.g. an oscillator's
  // startup seed), which CircuitJson itself cannot express. Frontend "Run" uses this when present.
  analysisConfig Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  org Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("templates")
}

// ============================================================================
// Assets (SPICE models, symbol packs, etc.)
// ============================================================================

model Asset {
  id          String    @id @default(uuid())
  orgId       String
  type        AssetType
  name        String
  description String?
  contentType String
  sizeBytes   Int
  s3Key       String
  sha256      String
  createdAt   DateTime  @default(now())

  // Relations
  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // The storage quota aggregates SUM(sizeBytes) per org on every upload presign.
  @@index([orgId])
  @@map("assets")
}

enum AssetType {
  SPICE_MODEL
  SYMBOL_PACK
  OTHER
}

// ============================================================================
// Simulation Jobs
// ============================================================================

model SimulationJob {
  id               String       @id @default(uuid())
  orgId            String
  projectVersionId String?
  status           SimJobStatus @default(QUEUED)
  engine           SimEngine    @default(NGSPICE)
  analysisConfig   Json
  netlist          String       @db.Text
  stdout           String?      @db.Text
  stderr           String?      @db.Text
  resultJson       Json?
  resultS3Key      String?
  metrics          Json?        // { runtimeMs, peakMemBytes, pointsCount }
  errorMessage     String?
  createdAt        DateTime     @default(now())
  startedAt        DateTime?
  finishedAt       DateTime?

  // Relations
  org            Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  projectVersion ProjectVersion? @relation(fields: [projectVersionId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
  @@index([status])
  @@map("simulation_jobs")
}

enum SimJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELED
  TIMED_OUT
}

enum SimEngine {
  NGSPICE
}

// ============================================================================
// Audit Logs
// ============================================================================

model AuditLog {
  id         String   @id @default(uuid())
  orgId      String? // null = user-scoped event (auth.* — login, reset, …) with no org context
  userId     String
  action     String   // e.g., "project.create", "simulation.start", "auth.login_failed"
  entityType String   // e.g., "Project", "SimulationJob", "User"
  entityId   String
  meta       Json?    // Additional context
  createdAt  DateTime @default(now())

  // Relations. DELIBERATE: user-cascade means erasing an account also erases its audit rows. These
  // rows hold the user's PII (ip/userAgent), so cascade is the GDPR-erasure-aligned default and keeps
  // account deletion unblocked. TRADEOFF: security-evidence events (refresh_reuse_detected,
  // account_locked) die with the account — if/when a compliance regime requires audit to OUTLIVE the
  // subject, switch userId to optional + onDelete:SetNull (anonymize the actor, keep the row).
  org  Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
// ============================================================================
// Usage metering (quota counters that have no natural source table — e.g. parts catalog calls).
// Sim runtime/jobs and storage are aggregated ON-DEMAND from SimulationJob / Asset (drift-free),
// so they intentionally have NO counter rows here.
// ============================================================================

model UsageRecord {
  id        String   @id @default(uuid())
  scope     String // 'org' | 'user'
  scopeId   String
  metric    String // e.g. 'parts_calls'
  period    String // UTC month, 'YYYY-MM'
  amount    Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([scope, scopeId, metric, period])
  @@map("usage_records")
}
