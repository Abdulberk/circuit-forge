# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/circuitforge

# Redis
REDIS_URL=redis://localhost:6379

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-min-32-characters
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# S3 / MinIO Object Storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=circuitforge
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# Simulation Settings
SIM_TIMEOUT_MS=10000
SIM_MAX_OUTPUT_BYTES=5242880
SIM_TEMP_DIR=/tmp/sim

# AI verify-and-fix loop: path to an ngspice binary the API can run IN-PROCESS to verify a generated
# circuit before returning it (the `simulate_circuit` tool). When unset, the AI still generates but
# does not self-verify via simulation. Local binary, no network. The async worker uses its own NGSPICE_PATH.
# Windows (chocolatey): C:/ProgramData/chocolatey/lib/ngspice/tools/Spice64/bin/ngspice_con.exe
# Linux/macOS: ngspice
# NGSPICE_PATH=ngspice

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=120

# Logging
LOG_LEVEL=info
NODE_ENV=development

# API Server (main.ts reads PORT; API_PORT is currently unused)
PORT=3000
API_PORT=3000
API_HOST=0.0.0.0

# AI Circuit Generation — SERVER-SIDE ONLY, never expose to clients.
# Anthropic-compatible provider (the Anthropic SDK appends /v1/messages to LLM_BASE_URL).
# Required for POST /generate-circuit.
LLM_API_KEY=
LLM_BASE_URL=https://api.zentio.dev
LLM_MODEL=claude-sonnet-4-6
# Optional: the gateway's WAF blocks the SDK's default User-Agent; a neutral UA is used by default.
# LLM_USER_AGENT=Mozilla/5.0 (circuit-forge)

# Component Catalog (TME) — SERVER-SIDE ONLY, never expose to clients.
# OAuth2 client_credentials: TME_TOKEN is the 50-char app token, TME_SECRET the 20-char app secret
# (developers.tme.eu -> Applications). Required for the /parts/* endpoints.
TME_TOKEN=
TME_SECRET=
TME_BASE_URL=https://api.tme.eu
# Default market (affects pricing/availability). PL = broadest catalog.
TME_DEFAULT_COUNTRY=PL
TME_DEFAULT_LANGUAGE=en
TME_DEFAULT_CURRENCY=EUR
# Optional tuning
TME_TIMEOUT_MS=10000
TME_MAX_CONCURRENCY=4
# Caps the manufacturers list to the largest-by-product-count entries (safety bound).
TME_MAX_MANUFACTURERS=5000
TME_REF_TTL_MS=86400000
TME_SEARCH_TTL_MS=60000