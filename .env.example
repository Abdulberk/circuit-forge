# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/circuitforge
# Prisma connection-pool size. Defaults to 10 if neither this nor a `connection_limit` query param on
# DATABASE_URL is set (Prisma's own default of ~5 is too low for the AI design loop's status polling).
# Keep (instances × limit) under Postgres max_connections.
# DB_CONNECTION_LIMIT=10

# Redis
REDIS_URL=redis://localhost:6379

# JWT Authentication
# REQUIRED: the API refuses to start unless both are set, >= 32 chars, and DIFFERENT from each other.
# Generate with: openssl rand -base64 48
JWT_SECRET=your-super-secret-jwt-key-min-32-characters
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Account lifecycle
# Base URL of the browser app — used to build email verification / password-reset links.
APP_URL=http://localhost:3000
# When 'true', unverified users cannot log in (403 EMAIL_NOT_VERIFIED). Off by default so the
# verification email is informational until you choose to enforce it.
# REQUIRE_EMAIL_VERIFICATION=false
# Email delivery — provider-agnostic, chosen at boot. With nothing set, the LOG transport writes
# verification/reset links to the API log (zero-setup dev/CI). For real email set EMAIL_FROM + pick a
# provider (auto-detect is SES-first, then SMTP, then log):
# EMAIL_FROM=no-reply@yourdomain.com           # required to send real email (SES-verified / SMTP sender)
# EMAIL_PROVIDER=ses                            # ses | smtp | log | (unset = auto-detect)
#   --- SES: credentials resolve via the default AWS chain (env AWS_ACCESS_KEY_ID/SECRET or IAM role) ---
# SES_REGION=eu-west-1                           # or AWS_REGION
#   --- SMTP (any provider: SendGrid/Mailgun/Postmark/self-hosted) ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false                              # true for port 465
# SMTP_USER=
# SMTP_PASS=

# S3 / MinIO Object Storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=circuitforge
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# Simulation Settings
SIM_TIMEOUT_MS=10000
SIM_MAX_OUTPUT_BYTES=5242880
SIM_TEMP_DIR=/tmp/sim
# Worker caps each stored probe series to this many points (min-max bucketed) so a long transient
# can't bloat the DB/S3 payload, the API hydrate, or the response. Full resolution lives in metrics.
WORKER_MAX_POINTS=20000

# ngspice resource-limit hardening (runs user-supplied SPICE). Enforced on LINUX only (prod
# containers); a no-op on Windows/macOS dev. 'auto' (default) = rlimit on Linux, none elsewhere;
# 'rlimit' forces it; 'none' disables it. The kernel caps the ngspice process so a malicious/
# pathological circuit can't OOM the host, fill the disk, spin CPU, or fork-bomb.
# (Stronger network/filesystem isolation — bubblewrap / per-job container — is a recommended add-on.)
# SIM_SANDBOX=auto
# SIM_SANDBOX_MEMORY_MB=2048     # RLIMIT_AS (virtual memory)
# SIM_SANDBOX_CPU_SEC=            # RLIMIT_CPU; default ≈ 2×(SIM_TIMEOUT) + 5s
# SIM_SANDBOX_FSIZE_MB=256        # RLIMIT_FSIZE (max output file)
# SIM_SANDBOX_NPROC=64            # RLIMIT_NPROC (max processes/threads)
# SIM_SANDBOX_USER=simrunner      # Linux: run ngspice as this dedicated low-privilege user (via su-exec) so
#                                 # it has its own process-count limit + no worker privileges. The worker
#                                 # Docker image creates 'simrunner' and sets this automatically.

# AI verify-and-fix loop: path to an ngspice binary the API can run IN-PROCESS to verify a generated
# circuit before returning it (the `simulate_circuit` tool). When unset, the AI still generates but
# does not self-verify via simulation. Local binary, no network. The async worker uses its own NGSPICE_PATH.
# Windows (chocolatey): C:/ProgramData/chocolatey/lib/ngspice/tools/Spice64/bin/ngspice_con.exe
# Linux/macOS: ngspice
# NGSPICE_PATH=ngspice

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=120

# Logging
LOG_LEVEL=info
NODE_ENV=development

# Observability (OpenTelemetry) — INERT by default (zero overhead). The SDK starts only when
# OTEL_ENABLED=true OR OTEL_EXPORTER_OTLP_ENDPOINT is set. When on, BOTH the API and the worker export
# traces (HTTP/Express/Nest + outgoing HTTP, Redis/ioredis) and metrics over OTLP/HTTP. The worker also emits
# custom sim metrics: circuitforge.sim.runs (count by status), circuitforge.sim.duration (ms), and
# circuitforge.sim.points (TRUE pre-downsample size — a memory-pressure proxy). See docs/OBSERVABILITY.md
# for the full signal list and recommended alerts.
# OTEL_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318   # base OTLP/HTTP URL; exporters append /v1/traces, /v1/metrics
# OTEL_SERVICE_NAME=                                   # overrides per-app default (circuit-forge-api / circuit-forge-worker)
# OTEL_METRIC_EXPORT_INTERVAL_MS=30000                 # metric push interval
# OTEL_DEBUG=false                                     # true → log SDK diagnostics to console

# API Server (main.ts reads PORT; API_PORT is currently unused)
PORT=3000
API_PORT=3000
API_HOST=0.0.0.0

# CORS allowlist — comma-separated origins the browser app is served from. If unset, defaults to
# localhost dev origins (http://localhost:3000, http://localhost:5173). NEVER a wildcard.
# CORS_ORIGINS=https://app.circuitforge.io,https://staging.circuitforge.io

# Swagger /docs is served in non-production automatically. To expose it in production, set this true.
# ENABLE_SWAGGER=false

# AI Circuit Generation — SERVER-SIDE ONLY, never expose to clients.
# Anthropic-compatible provider (the Anthropic SDK appends /v1/messages to LLM_BASE_URL).
# Required for POST /generate-circuit.
LLM_API_KEY=
LLM_BASE_URL=https://api.zentio.dev
LLM_MODEL=claude-sonnet-4-6
# Optional: the gateway's WAF blocks the SDK's default User-Agent; a neutral UA is used by default.
# LLM_USER_AGENT=Mozilla/5.0 (circuit-forge)

# Component Catalog (TME) — SERVER-SIDE ONLY, never expose to clients.
# OAuth2 client_credentials: TME_TOKEN is the 50-char app token, TME_SECRET the 20-char app secret
# (developers.tme.eu -> Applications). Required for the /parts/* endpoints.
TME_TOKEN=
TME_SECRET=
TME_BASE_URL=https://api.tme.eu
# Default market (affects pricing/availability). PL = broadest catalog.
TME_DEFAULT_COUNTRY=PL
TME_DEFAULT_LANGUAGE=en
TME_DEFAULT_CURRENCY=EUR
# Optional tuning
TME_TIMEOUT_MS=10000
TME_MAX_CONCURRENCY=4
# Caps the manufacturers list to the largest-by-product-count entries (safety bound).
TME_MAX_MANUFACTURERS=5000
TME_REF_TTL_MS=86400000
TME_SEARCH_TTL_MS=60000
# Product-detail cache TTL — dedupes repeated part lookups within one AI design session (less TME load).
TME_PRODUCT_TTL_MS=300000
# Total attempts on a transient TME failure (5xx / network / 429 rate-limit). 1 = no retry. 429 honours Retry-After.
TME_MAX_RETRIES=3